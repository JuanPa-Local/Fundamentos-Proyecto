<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane style="-fx-background-color: #121212;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.openlib.backend.UI.AdminController">

    <!-- ── NAVBAR ── -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16" style="-fx-background-color: #1e1e1e;                      -fx-padding: 14 24 14 24;                      -fx-border-color: #2c2c2c;                      -fx-border-width: 0 0 1 0;">

            <Label style="-fx-text-fill: #cf6679; -fx-font-size: 20px; -fx-font-weight: bold;" text="OpenLib" />
            <Label style="-fx-text-fill: #ffffff; -fx-font-size: 20px;" text="Admin" />

            <Region HBox.hgrow="ALWAYS" />

            <Label style="-fx-text-fill: #555555; -fx-font-size: 12px;" text="Panel de administración" />

            <Button fx:id="closeSession" onAction="#handleLogout" style="-fx-background-color: transparent; -fx-text-fill: #888888;                            -fx-border-color: #3a3a3a; -fx-border-radius: 8;                            -fx-background-radius: 8; -fx-padding: 8 16; -fx-cursor: hand;" text="Cerrar Sesión" />
        </HBox>
    </top>

    <!-- ── SIDEBAR ── -->
    <left>
        <VBox minWidth="200" spacing="4" style="-fx-background-color: #1a1a1a;                      -fx-padding: 20 12 20 12;                      -fx-border-color: #2c2c2c;                      -fx-border-width: 0 1 0 0;">

            <Label style="-fx-text-fill: #888888; -fx-font-size: 11px;                           -fx-font-weight: bold; -fx-padding: 0 0 8 8;" text="Navegación" />

            <Button fx:id="btnDashboard" maxWidth="Infinity" onAction="#showDashboard" style="-fx-background-color: #cf667922; -fx-text-fill: #cf6679;                            -fx-alignment: CENTER_LEFT; -fx-background-radius: 8;                            -fx-border-color: transparent; -fx-padding: 10 12; -fx-cursor: hand;" text="  Dashboard" />

            <Button maxWidth="Infinity" onAction="#showUsuarios" style="-fx-background-color: transparent; -fx-text-fill: #cccccc;                            -fx-alignment: CENTER_LEFT; -fx-background-radius: 8;                            -fx-border-color: transparent; -fx-padding: 10 12; -fx-cursor: hand;" text="  Usuarios" />

            <Button maxWidth="Infinity" onAction="#showLibros" style="-fx-background-color: transparent; -fx-text-fill: #cccccc;                            -fx-alignment: CENTER_LEFT; -fx-background-radius: 8;                            -fx-border-color: transparent; -fx-padding: 10 12; -fx-cursor: hand;" text="  Libros" />

            <Button maxWidth="Infinity" onAction="#showOrdenes" style="-fx-background-color: transparent; -fx-text-fill: #cccccc;                            -fx-alignment: CENTER_LEFT; -fx-background-radius: 8;                            -fx-border-color: transparent; -fx-padding: 10 12; -fx-cursor: hand;" text="  Órdenes" />
        </VBox>
    </left>

    <!-- ── ÁREA DE CONTENIDO ── -->
    <center>
        <StackPane fx:id="contentArea" style="-fx-background-color: #121212;">

            <!-- ── DASHBOARD ── -->
            <VBox fx:id="panelDashboard" spacing="24" style="-fx-padding: 28 28 28 28; -fx-background-color: #121212;">

                <Label style="-fx-text-fill: #ffffff; -fx-font-size: 22px; -fx-font-weight: bold;" text="Dashboard" />

                <!-- Tarjetas de métricas -->
                <HBox spacing="16">
                    <!-- Usuarios activos -->
                    <VBox spacing="6" style="-fx-background-color: #1e1e1e; -fx-background-radius: 12;                                  -fx-padding: 20; -fx-border-color: #2c2c2c; -fx-border-radius: 12;" HBox.hgrow="ALWAYS">
                        <Label style="-fx-text-fill: #888888; -fx-font-size: 11px; -fx-font-weight: bold;" text="USUARIOS ACTIVOS" />
                        <Label fx:id="lblUsuarios" style="-fx-text-fill: #ffffff; -fx-font-size: 32px; -fx-font-weight: bold;" text="—" />
                        <Label style="-fx-text-fill: #555555; -fx-font-size: 12px;" text="registrados en total" />
                    </VBox>

                    <!-- Libros -->
                    <VBox spacing="6" style="-fx-background-color: #1e1e1e; -fx-background-radius: 12;                                  -fx-padding: 20; -fx-border-color: #2c2c2c; -fx-border-radius: 12;" HBox.hgrow="ALWAYS">
                        <Label style="-fx-text-fill: #888888; -fx-font-size: 11px; -fx-font-weight: bold;" text="LIBROS EN CATÁLOGO" />
                        <Label fx:id="lblLibros" style="-fx-text-fill: #03dac6; -fx-font-size: 32px; -fx-font-weight: bold;" text="—" />
                        <Label style="-fx-text-fill: #555555; -fx-font-size: 12px;" text="disponibles para descarga" />
                    </VBox>

                    <!-- Órdenes -->
                    <VBox spacing="6" style="-fx-background-color: #1e1e1e; -fx-background-radius: 12;                                  -fx-padding: 20; -fx-border-color: #2c2c2c; -fx-border-radius: 12;" HBox.hgrow="ALWAYS">
                        <Label style="-fx-text-fill: #888888; -fx-font-size: 11px; -fx-font-weight: bold;" text="DESCARGAS TOTALES" />
                        <Label fx:id="lblOrdenes" style="-fx-text-fill: #bb86fc; -fx-font-size: 32px; -fx-font-weight: bold;" text="—" />
                        <Label style="-fx-text-fill: #555555; -fx-font-size: 12px;" text="órdenes completadas" />
                    </VBox>
                </HBox>

                <!-- Órdenes recientes -->
                <VBox spacing="12" style="-fx-background-color: #1e1e1e; -fx-background-radius: 12;                              -fx-padding: 20; -fx-border-color: #2c2c2c; -fx-border-radius: 12;">
                    <HBox alignment="CENTER_LEFT">
                        <Label style="-fx-text-fill: #ffffff; -fx-font-size: 15px; -fx-font-weight: bold;" text="Actividad reciente" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button onAction="#showOrdenes" style="-fx-background-color: transparent; -fx-text-fill: #bb86fc;                                        -fx-border-color: transparent; -fx-cursor: hand; -fx-font-size: 12px;" text="Ver todo" />
                    </HBox>

                    <TableView fx:id="recentOrdersTable" prefHeight="200" style="-fx-background-color: transparent; -fx-border-color: transparent;                                       -fx-table-cell-border-color: #2c2c2c;">
                        <columns>
                            <TableColumn fx:id="rColUser" prefWidth="200" text="Usuario" />
                            <TableColumn fx:id="rColBook" prefWidth="260" text="Libro" />
                            <TableColumn fx:id="rColDate" prefWidth="160" text="Fecha" />
                        </columns>
                        <placeholder>
                            <Label style="-fx-text-fill: #555555;" text="Sin actividad reciente." />
                        </placeholder>
                    </TableView>
                </VBox>
            </VBox>

            <!-- ── PANEL USUARIOS ── -->
            <VBox fx:id="panelUsuarios" spacing="16" style="-fx-padding: 28; -fx-background-color: #121212;" visible="false">

                <HBox alignment="CENTER_LEFT">
                    <Label style="-fx-text-fill: #ffffff; -fx-font-size: 22px; -fx-font-weight: bold;" text="Gestión de usuarios" />
                    <Region HBox.hgrow="ALWAYS" />
                    <TextField fx:id="searchUserField" onAction="#buscarUsuario" prefWidth="240" promptText="Buscar usuario..." style="-fx-background-color: #2c2c2c; -fx-text-fill: #ffffff;                                       -fx-prompt-text-fill: #555555; -fx-background-radius: 8;                                       -fx-border-color: #3a3a3a; -fx-border-radius: 8;                                       -fx-padding: 8 14; -fx-font-size: 13px;" />
                </HBox>

                <TableView fx:id="usersTable" style="-fx-background-color: #1e1e1e; -fx-border-color: #2c2c2c;                                   -fx-background-radius: 12; -fx-table-cell-border-color: #2c2c2c;" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="uColId" prefWidth="80" text="ID" />
                        <TableColumn fx:id="uColName" prefWidth="200" text="Nombre" />
                        <TableColumn fx:id="uColEmail" prefWidth="240" text="Email" />
                        <TableColumn fx:id="uColRole" prefWidth="100" text="Rol" />
                        <TableColumn fx:id="uColDate" prefWidth="160" text="Registro" />
                        <TableColumn fx:id="uColActions" prefWidth="120" text="Acciones" />
                    </columns>
                    <placeholder>
                        <Label style="-fx-text-fill: #555555; -fx-font-size: 14px;" text="No hay usuarios registrados." />
                    </placeholder>
                </TableView>
            </VBox>

            <!-- ── PANEL LIBROS ── -->
            <VBox fx:id="panelLibros" spacing="16" style="-fx-padding: 28; -fx-background-color: #121212;" visible="false">

                <HBox alignment="CENTER_LEFT">
                    <Label style="-fx-text-fill: #ffffff; -fx-font-size: 22px; -fx-font-weight: bold;" text="Gestión de libros" />
                    <Region HBox.hgrow="ALWAYS" />
                    <TextField fx:id="searchBookField" onAction="#buscarLibro" prefWidth="240" promptText="Buscar libro..." style="-fx-background-color: #2c2c2c; -fx-text-fill: #ffffff;                                       -fx-prompt-text-fill: #555555; -fx-background-radius: 8;                                       -fx-border-color: #3a3a3a; -fx-border-radius: 8;                                       -fx-padding: 8 14; -fx-font-size: 13px;" />
                </HBox>

                <TableView fx:id="booksAdminTable" style="-fx-background-color: #1e1e1e; -fx-border-color: #2c2c2c;                                   -fx-background-radius: 12; -fx-table-cell-border-color: #2c2c2c;" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="bColTitle" prefWidth="240" text="Título" />
                        <TableColumn fx:id="bColAuthor" prefWidth="180" text="Autor" />
                        <TableColumn fx:id="bColCategory" prefWidth="130" text="Categoría" />
                        <TableColumn fx:id="bColIsbn" prefWidth="130" text="ISBN" />
                        <TableColumn fx:id="bColDate" prefWidth="140" text="Publicado" />
                        <TableColumn fx:id="bColActions" prefWidth="100" text="Acciones" />
                    </columns>
                    <placeholder>
                        <Label style="-fx-text-fill: #555555; -fx-font-size: 14px;" text="No hay libros en el sistema." />
                    </placeholder>
                </TableView>
            </VBox>

            <!-- ── PANEL ÓRDENES ── -->
            <VBox fx:id="panelOrdenes" spacing="16" style="-fx-padding: 28; -fx-background-color: #121212;" visible="false">

                <HBox alignment="CENTER_LEFT">
                    <Label style="-fx-text-fill: #ffffff; -fx-font-size: 22px; -fx-font-weight: bold;" text="Órdenes / Descargas" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="totalOrdersLabel" style="-fx-text-fill: #888888; -fx-font-size: 13px;" text="" />
                </HBox>

                <TableView fx:id="ordersTable" style="-fx-background-color: #1e1e1e; -fx-border-color: #2c2c2c;                                   -fx-background-radius: 12; -fx-table-cell-border-color: #2c2c2c;" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="oColId" prefWidth="100" text="Orden ID" />
                        <TableColumn fx:id="oColUser" prefWidth="200" text="Usuario" />
                        <TableColumn fx:id="oColBook" prefWidth="240" text="Libro" />
                        <TableColumn fx:id="oColStatus" prefWidth="110" text="Estado" />
                        <TableColumn fx:id="oColDate" prefWidth="160" text="Fecha" />
                    </columns>
                    <placeholder>
                        <Label style="-fx-text-fill: #555555; -fx-font-size: 14px;" text="No hay órdenes registradas." />
                    </placeholder>
                </TableView>
            </VBox>

        </StackPane>
    </center>

</BorderPane>
