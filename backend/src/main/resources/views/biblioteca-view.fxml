<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" 
            fx:controller="com.openlib.backend.UI.BibliotecaController"
            style="-fx-background-color: #121212;">

    <top>
        <HBox spacing="20" alignment="CENTER_LEFT" style="-fx-padding: 15; -fx-background-color: #1e1e1e; -fx-border-color: #2c2c2c; -fx-border-width: 0 0 1 0;">
            <Label text="Mi Biblioteca" style="-fx-text-fill: #bb86fc; -fx-font-size: 20px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS" />
            <Button text="Volver al Catálogo" onAction="#goToCatalogo" styleClass="secondary-btn" stylesheets="@../styles/global.css"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="15" style="-fx-padding: 20;">
            <Label fx:id="statusLabel" text="Cargando biblioteca..." style="-fx-text-fill: #888888; -fx-font-size: 14px;"/>
            
            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: #121212;" VBox.vgrow="ALWAYS">
                <FlowPane fx:id="booksContainer" hgap="20" vgap="20" style="-fx-background-color: transparent;"/>
            </ScrollPane>
        </VBox>
    </center>

</BorderPane>
