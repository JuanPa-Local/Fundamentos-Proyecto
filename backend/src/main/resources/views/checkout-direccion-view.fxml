<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" 
      fx:controller="com.openlib.backend.UI.CheckoutDireccionController"
      spacing="15" alignment="CENTER" stylesheets="@../styles/global.css">

    <Label text="Dirección de Facturación" styleClass="title-label"/>
    <Label text="Estos datos son solo para registro de tu adquisición." textFill="gray" styleClass="info-label"/>
    
    <GridPane vgap="10" hgap="10" alignment="CENTER">
        <Label text="Calle:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="calleField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        
        <Label text="Ciudad:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="ciudadField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        
        <Label text="Departamento/Estado:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="departamentoField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        
        <Label text="País:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="paisField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
    </GridPane>
    
    <HBox spacing="20" alignment="CENTER">
        <Button text="Cancelar (Volver al Carrito)" onAction="#handleCancelar" styleClass="secondary-btn"/>
        <Button text="Continuar" onAction="#handleContinuar" styleClass="primary-btn"/>
    </HBox>

</VBox>
