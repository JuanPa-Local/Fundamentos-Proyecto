<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="0" xmlns="http://javafx.com/javafx/8"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.openlib.backend.UI.ControllerUI"
      style="-fx-background-color: #121212;"
      prefWidth="420" prefHeight="580">

    <!-- Tarjeta central -->
    <VBox alignment="CENTER" spacing="16"
          style="-fx-background-color: #1e1e1e; -fx-background-radius: 16;
                 -fx-padding: 44 48 44 48;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.6), 20, 0, 0, 4);"
          maxWidth="380">

        <!-- Logo -->
        <HBox alignment="CENTER" spacing="6">
            <Label text="OpenLib" style="-fx-text-fill: #bb86fc; -fx-font-size: 28px; -fx-font-weight: bold;"/>
            <Label text="Market"  style="-fx-text-fill: #ffffff;  -fx-font-size: 28px;"/>
        </HBox>
        <Label text="Inicia sesión para continuar"
               style="-fx-text-fill: #888888; -fx-font-size: 13px;"/>

        <Region prefHeight="8"/>

        <!-- Email -->
        <VBox spacing="6">
            <Label text="Correo electrónico"
                   style="-fx-text-fill: #cccccc; -fx-font-size: 13px;"/>
            <TextField fx:id="userField"
                       promptText="correo@ejemplo.com"
                       style="-fx-background-color: #2c2c2c; -fx-text-fill: #ffffff;
                              -fx-prompt-text-fill: #555555; -fx-background-radius: 8;
                              -fx-border-color: #3a3a3a; -fx-border-radius: 8;
                              -fx-padding: 10 14; -fx-font-size: 14px;"/>
        </VBox>

        <!-- Contraseña -->
        <VBox spacing="6">
            <Label text="Contraseña"
                   style="-fx-text-fill: #cccccc; -fx-font-size: 13px;"/>
            <PasswordField fx:id="passwordField"
                           promptText="••••••••"
                           style="-fx-background-color: #2c2c2c; -fx-text-fill: #ffffff;
                                  -fx-prompt-text-fill: #555555; -fx-background-radius: 8;
                                  -fx-border-color: #3a3a3a; -fx-border-radius: 8;
                                  -fx-padding: 10 14; -fx-font-size: 14px;"/>
        </VBox>

        <!-- Error label -->
        <Label fx:id="errorLabel" text="" wrapText="true"
               style="-fx-text-fill: #cf6679; -fx-font-size: 12px;"
               maxWidth="284"/>

        <Region prefHeight="4"/>

        <!-- Botón login -->
        <Button fx:id="loginButton" text="Iniciar Sesión"
                maxWidth="Infinity" onAction="#handleLogin"
                style="-fx-background-color: #bb86fc; -fx-text-fill: #000000;
                       -fx-font-weight: bold; -fx-font-size: 14px;
                       -fx-background-radius: 8; -fx-padding: 12 0; -fx-cursor: hand;"/>

        <!-- Link registro -->
        <HBox alignment="CENTER" spacing="4">
            <Label text="¿No tienes cuenta?"
                   style="-fx-text-fill: #888888; -fx-font-size: 13px;"/>
            <Hyperlink text="Regístrate aquí"
                       onAction="#goToRegister"
                       style="-fx-text-fill: #bb86fc; -fx-font-size: 13px;
                              -fx-border-color: transparent;"/>
        </HBox>
    </VBox>
</VBox>
