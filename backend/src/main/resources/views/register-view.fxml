<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="0" style="-fx-background-color: #121212;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.openlib.backend.UI.RegisterController">

    <!-- Tarjeta central -->
    <VBox alignment="CENTER" maxWidth="420" spacing="16" style="-fx-background-color: #1e1e1e; -fx-background-radius: 16;                  -fx-padding: 40 48 40 48; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.6), 20, 0, 0, 4);">

        <!-- Título -->
        <Label style="-fx-text-fill: #ffffff; -fx-font-size: 26px; -fx-font-weight: bold;" text="Crear cuenta" />
        <Label style="-fx-text-fill: #888888; -fx-font-size: 13px;" text="Completa los datos para registrarte" />

        <Region prefHeight="8" />

        <!-- Nombre completo -->
        <VBox spacing="6">
            <Label style="-fx-text-fill: #cccccc; -fx-font-size: 13px;" text="Nombre completo" />
            <TextField fx:id="fullNameField" promptText="Ej: Juan Pérez" style="-fx-background-color: #2c2c2c; -fx-text-fill: #ffffff;                               -fx-prompt-text-fill: #555555; -fx-background-radius: 8;                               -fx-border-color: #3a3a3a; -fx-border-radius: 8;                               -fx-padding: 10 14; -fx-font-size: 14px;" />
        </VBox>

        <!-- Email -->
        <VBox spacing="6">
            <Label style="-fx-text-fill: #cccccc; -fx-font-size: 13px;" text="Correo electrónico" />
            <TextField fx:id="emailField" promptText="correo@ejemplo.com" style="-fx-background-color: #2c2c2c; -fx-text-fill: #ffffff;                               -fx-prompt-text-fill: #555555; -fx-background-radius: 8;                               -fx-border-color: #3a3a3a; -fx-border-radius: 8;                               -fx-padding: 10 14; -fx-font-size: 14px;" />
        </VBox>

        <!-- Contraseña -->
        <VBox spacing="6">
            <Label style="-fx-text-fill: #cccccc; -fx-font-size: 13px;" text="Contraseña" />
            <PasswordField fx:id="passwordField" promptText="Mínimo 8 caracteres" style="-fx-background-color: #2c2c2c; -fx-text-fill: #ffffff;                                   -fx-prompt-text-fill: #555555; -fx-background-radius: 8;                                   -fx-border-color: #3a3a3a; -fx-border-radius: 8;                                   -fx-padding: 10 14; -fx-font-size: 14px;" />
        </VBox>

        <!-- Confirmar contraseña -->
        <VBox spacing="6">
            <Label style="-fx-text-fill: #cccccc; -fx-font-size: 13px;" text="Confirmar contraseña" />
            <PasswordField fx:id="confirmPasswordField" promptText="Repite tu contraseña" style="-fx-background-color: #2c2c2c; -fx-text-fill: #ffffff;                                   -fx-prompt-text-fill: #555555; -fx-background-radius: 8;                                   -fx-border-color: #3a3a3a; -fx-border-radius: 8;                                   -fx-padding: 10 14; -fx-font-size: 14px;" />
        </VBox>

        <!-- Tipo de cuenta -->
        <VBox spacing="6">
            <Label style="-fx-text-fill: #cccccc; -fx-font-size: 13px;" text="Tipo de cuenta" />
            <ComboBox fx:id="roleComboBox" maxWidth="Infinity" promptText="Selecciona un rol" style="-fx-background-color: #2c2c2c; -fx-text-fill: #ffffff;                              -fx-border-color: #3a3a3a; -fx-border-radius: 8;                              -fx-background-radius: 8; -fx-font-size: 14px;" />
        </VBox>

        <!-- Mensaje de error -->
        <Label fx:id="errorLabel" maxWidth="324" style="-fx-text-fill: #cf6679; -fx-font-size: 12px;" text="" wrapText="true" />

        <!-- Mensaje de éxito -->
        <Label fx:id="successLabel" maxWidth="324" style="-fx-text-fill: #4caf50; -fx-font-size: 12px;" text="" wrapText="true" />

        <Region prefHeight="4" />

        <!-- Botón registrar -->
        <Button fx:id="registerButton" maxWidth="Infinity" onAction="#handleRegister" style="-fx-background-color: #bb86fc; -fx-text-fill: #000000;                        -fx-font-weight: bold; -fx-font-size: 14px;                        -fx-background-radius: 8; -fx-padding: 12 0; -fx-cursor: hand;" text="Crear cuenta" />

        <!-- Link volver al login -->
        <HBox alignment="CENTER" spacing="4">
            <Label style="-fx-text-fill: #888888; -fx-font-size: 13px;" text="¿Ya tienes cuenta?" />
            <Hyperlink fx:id="closeSession" onAction="#goToLogin" style="-fx-text-fill: #bb86fc; -fx-font-size: 13px;                               -fx-border-color: transparent;" text="Inicia sesión aquí" />
        </HBox>

    </VBox>
</VBox>
