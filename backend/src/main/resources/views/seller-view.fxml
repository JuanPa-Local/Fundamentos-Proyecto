<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/8"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.openlib.backend.UI.SellerController"
            style="-fx-background-color: #121212;">

    <!-- ── NAVBAR ── -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16"
              style="-fx-background-color: #1e1e1e;
                     -fx-padding: 14 24 14 24;
                     -fx-border-color: #2c2c2c;
                     -fx-border-width: 0 0 1 0;">

            <Label text="OpenLib" style="-fx-text-fill: #03dac6; -fx-font-size: 20px; -fx-font-weight: bold;"/>
            <Label text="Seller" style="-fx-text-fill: #ffffff; -fx-font-size: 20px;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label fx:id="sellerNameLabel" text="Mi cuenta"
                   style="-fx-text-fill: #888888; -fx-font-size: 13px;"/>

            <Button text="Cerrar Sesión" onAction="#handleLogout"
                    style="-fx-background-color: transparent; -fx-text-fill: #888888;
                           -fx-border-color: #3a3a3a; -fx-border-radius: 8;
                           -fx-background-radius: 8; -fx-padding: 8 16; -fx-cursor: hand;"/>
        </HBox>
    </top>

    <!-- ── CONTENIDO CON TABS ── -->
    <center>
        <TabPane fx:id="mainTabs" tabClosingPolicy="UNAVAILABLE"
                 style="-fx-background-color: #121212; -fx-tab-min-height: 40px;">

            <!-- ── TAB 1: MIS PUBLICACIONES ── -->
            <Tab text="Mis Publicaciones">
                <VBox spacing="0" style="-fx-background-color: #121212;">

                    <HBox alignment="CENTER_LEFT" spacing="12"
                          style="-fx-padding: 20 24 12 24;">
                        <Label text="Mis libros publicados"
                               style="-fx-text-fill: #ffffff; -fx-font-size: 18px; -fx-font-weight: bold;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="totalBooksLabel" text="0 libros"
                               style="-fx-text-fill: #888888; -fx-font-size: 13px;"/>
                    </HBox>

                    <TableView fx:id="booksTable" VBox.vgrow="ALWAYS"
                               style="-fx-background-color: #1e1e1e;
                                      -fx-border-color: transparent;
                                      -fx-table-cell-border-color: #2c2c2c;">
                        <padding><Insets left="24" right="24"/></padding>
                        <columns>
                            <TableColumn fx:id="colTitle"    text="Título"       prefWidth="250"/>
                            <TableColumn fx:id="colAuthor"   text="Autor"        prefWidth="180"/>
                            <TableColumn fx:id="colCategory" text="Categoría"    prefWidth="140"/>
                            <TableColumn fx:id="colIsbn"     text="ISBN"         prefWidth="140"/>
                            <TableColumn fx:id="colDate"     text="Publicado"    prefWidth="140"/>
                            <TableColumn fx:id="colActions"  text="Acciones"     prefWidth="120"/>
                        </columns>
                        <placeholder>
                            <Label text="Aún no has publicado ningún libro."
                                   style="-fx-text-fill: #555555; -fx-font-size: 14px;"/>
                        </placeholder>
                    </TableView>
                </VBox>
            </Tab>

            <!-- ── TAB 2: PUBLICAR NUEVO LIBRO ── -->
            <Tab text="+ Publicar libro">
                <ScrollPane fitToWidth="true"
                            style="-fx-background-color: #121212; -fx-background: #121212;">
                    <VBox alignment="TOP_CENTER" spacing="0"
                          style="-fx-padding: 32 0; -fx-background-color: #121212;">

                        <!-- Tarjeta del formulario -->
                        <VBox spacing="20" maxWidth="600"
                              style="-fx-background-color: #1e1e1e;
                                     -fx-background-radius: 16;
                                     -fx-padding: 36 40;
                                     -fx-border-color: #2c2c2c;
                                     -fx-border-radius: 16;">

                            <Label text="Publicar nuevo libro"
                                   style="-fx-text-fill: #ffffff; -fx-font-size: 22px; -fx-font-weight: bold;"/>
                            <Label text="Completa la información del libro. El archivo PDF será almacenado de forma segura."
                                   wrapText="true"
                                   style="-fx-text-fill: #888888; -fx-font-size: 13px;"/>

                            <!-- Título -->
                            <VBox spacing="6">
                                <Label text="Título del libro *"
                                       style="-fx-text-fill: #cccccc; -fx-font-size: 13px;"/>
                                <TextField fx:id="titleField" promptText="Ej: Clean Code"
                                           style="-fx-background-color: #2c2c2c; -fx-text-fill: #ffffff;
                                                  -fx-prompt-text-fill: #555555; -fx-background-radius: 8;
                                                  -fx-border-color: #3a3a3a; -fx-border-radius: 8;
                                                  -fx-padding: 10 14; -fx-font-size: 14px;"/>
                            </VBox>

                            <!-- Autor -->
                            <VBox spacing="6">
                                <Label text="Autor *"
                                       style="-fx-text-fill: #cccccc; -fx-font-size: 13px;"/>
                                <TextField fx:id="authorField" promptText="Ej: Robert C. Martin"
                                           style="-fx-background-color: #2c2c2c; -fx-text-fill: #ffffff;
                                                  -fx-prompt-text-fill: #555555; -fx-background-radius: 8;
                                                  -fx-border-color: #3a3a3a; -fx-border-radius: 8;
                                                  -fx-padding: 10 14; -fx-font-size: 14px;"/>
                            </VBox>

                            <!-- ISBN y Categoría en fila -->
                            <HBox spacing="16">
                                <VBox spacing="6" HBox.hgrow="ALWAYS">
                                    <Label text="ISBN"
                                           style="-fx-text-fill: #cccccc; -fx-font-size: 13px;"/>
                                    <TextField fx:id="isbnField" promptText="978-..."
                                               style="-fx-background-color: #2c2c2c; -fx-text-fill: #ffffff;
                                                      -fx-prompt-text-fill: #555555; -fx-background-radius: 8;
                                                      -fx-border-color: #3a3a3a; -fx-border-radius: 8;
                                                      -fx-padding: 10 14; -fx-font-size: 14px;"/>
                                </VBox>
                                <VBox spacing="6" HBox.hgrow="ALWAYS">
                                    <Label text="Categoría *"
                                           style="-fx-text-fill: #cccccc; -fx-font-size: 13px;"/>
                                    <ComboBox fx:id="categoryCombo" maxWidth="Infinity"
                                              promptText="Selecciona una categoría"
                                              style="-fx-background-color: #2c2c2c; -fx-text-fill: #ffffff;
                                                     -fx-border-color: #3a3a3a; -fx-border-radius: 8;
                                                     -fx-background-radius: 8; -fx-font-size: 13px;"/>
                                </VBox>
                            </HBox>

                            <!-- Descripción -->
                            <VBox spacing="6">
                                <Label text="Descripción"
                                       style="-fx-text-fill: #cccccc; -fx-font-size: 13px;"/>
                                <TextArea fx:id="descriptionArea"
                                          promptText="Breve descripción del contenido del libro..."
                                          prefRowCount="4" wrapText="true"
                                          style="-fx-background-color: #2c2c2c; -fx-text-fill: #ffffff;
                                                 -fx-prompt-text-fill: #555555; -fx-background-radius: 8;
                                                 -fx-border-color: #3a3a3a; -fx-border-radius: 8;
                                                 -fx-padding: 10 14; -fx-font-size: 14px;"/>
                            </VBox>

                            <!-- Selector de PDF -->
                            <VBox spacing="6">
                                <Label text="Archivo PDF *"
                                       style="-fx-text-fill: #cccccc; -fx-font-size: 13px;"/>
                                <HBox spacing="10" alignment="CENTER_LEFT">
                                    <TextField fx:id="filePathField"
                                               promptText="Ningún archivo seleccionado"
                                               HBox.hgrow="ALWAYS" editable="false"
                                               style="-fx-background-color: #2c2c2c; -fx-text-fill: #888888;
                                                      -fx-prompt-text-fill: #555555; -fx-background-radius: 8;
                                                      -fx-border-color: #3a3a3a; -fx-border-radius: 8;
                                                      -fx-padding: 10 14; -fx-font-size: 13px;"/>
                                    <Button text="Seleccionar PDF" onAction="#selectPDF"
                                            style="-fx-background-color: #2c2c2c; -fx-text-fill: #03dac6;
                                                   -fx-border-color: #03dac6; -fx-border-radius: 8;
                                                   -fx-background-radius: 8; -fx-padding: 10 16;
                                                   -fx-cursor: hand;"/>
                                </HBox>
                            </VBox>

                            <!-- Mensajes -->
                            <Label fx:id="errorLabel" text="" wrapText="true"
                                   style="-fx-text-fill: #cf6679; -fx-font-size: 12px;"/>
                            <Label fx:id="successLabel" text="" wrapText="true"
                                   style="-fx-text-fill: #4caf50; -fx-font-size: 12px;"/>

                            <!-- Botón publicar -->
                            <Button fx:id="publishButton" text="Publicar libro"
                                    maxWidth="Infinity" onAction="#handlePublish"
                                    style="-fx-background-color: #03dac6; -fx-text-fill: #000000;
                                           -fx-font-weight: bold; -fx-font-size: 14px;
                                           -fx-background-radius: 8; -fx-padding: 13 0;
                                           -fx-cursor: hand;"/>
                        </VBox>
                    </VBox>
                </ScrollPane>
            </Tab>
        </TabPane>
    </center>

</BorderPane>
