<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane style="-fx-background-color: #121212;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.openlib.backend.UI.SellerController">

    <!-- ── NAVBAR ── -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16" style="-fx-background-color: #1e1e1e;                      -fx-padding: 14 24 14 24;                      -fx-border-color: #2c2c2c;                      -fx-border-width: 0 0 1 0;">

            <Label style="-fx-text-fill: #03dac6; -fx-font-size: 20px; -fx-font-weight: bold;" text="OpenLib" />
            <Label style="-fx-text-fill: #ffffff; -fx-font-size: 20px;" text="Seller" />

            <Region HBox.hgrow="ALWAYS" />

            <Label fx:id="sellerNameLabel" style="-fx-text-fill: #888888; -fx-font-size: 13px;" text="Mi cuenta" />

            <Button fx:id="closeSession" onAction="#handleLogout" style="-fx-background-color: transparent; -fx-text-fill: #888888;                            -fx-border-color: #3a3a3a; -fx-border-radius: 8;                            -fx-background-radius: 8; -fx-padding: 8 16; -fx-cursor: hand;" text="Cerrar Sesión" />
        </HBox>
    </top>

    <!-- ── CONTENIDO CON TABS ── -->
    <center>
        <TabPane fx:id="mainTabs" style="-fx-background-color: #121212; -fx-tab-min-height: 40px;" tabClosingPolicy="UNAVAILABLE">

            <!-- ── TAB 1: MIS PUBLICACIONES ── -->
            <Tab text="Mis Publicaciones">
                <VBox spacing="0" style="-fx-background-color: #121212;">

                    <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 20 24 12 24;">
                        <Label style="-fx-text-fill: #ffffff; -fx-font-size: 18px; -fx-font-weight: bold;" text="Mis libros publicados" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="totalBooksLabel" style="-fx-text-fill: #888888; -fx-font-size: 13px;" text="0 libros" />
                    </HBox>

                    <TableView fx:id="booksTable" style="-fx-background-color: #1e1e1e;                                       -fx-border-color: transparent;                                       -fx-table-cell-border-color: #2c2c2c;" VBox.vgrow="ALWAYS">
                        <padding><Insets left="24" right="24" /></padding>
                        <columns>
                            <TableColumn fx:id="colTitle" prefWidth="250" text="Título" />
                            <TableColumn fx:id="colAuthor" prefWidth="180" text="Autor" />
                            <TableColumn fx:id="colCategory" prefWidth="140" text="Categoría" />
                            <TableColumn fx:id="colIsbn" prefWidth="140" text="ISBN" />
                            <TableColumn fx:id="colDate" prefWidth="140" text="Publicado" />
                            <TableColumn fx:id="colActions" prefWidth="120" text="Acciones" />
                        </columns>
                        <placeholder>
                            <Label style="-fx-text-fill: #555555; -fx-font-size: 14px;" text="Aún no has publicado ningún libro." />
                        </placeholder>
                    </TableView>
                </VBox>
            </Tab>

            <!-- ── TAB 2: PUBLICAR NUEVO LIBRO ── -->
            <Tab text="+ Publicar libro">
                <ScrollPane fitToWidth="true" style="-fx-background-color: #121212; -fx-background: #121212;">
                    <VBox alignment="TOP_CENTER" spacing="0" style="-fx-padding: 32 0; -fx-background-color: #121212;">

                        <!-- Tarjeta del formulario -->
                        <VBox maxWidth="600" spacing="20" style="-fx-background-color: #1e1e1e;                                      -fx-background-radius: 16;                                      -fx-padding: 36 40;                                      -fx-border-color: #2c2c2c;                                      -fx-border-radius: 16;">

                            <Label style="-fx-text-fill: #ffffff; -fx-font-size: 22px; -fx-font-weight: bold;" text="Publicar nuevo libro" />
                            <Label style="-fx-text-fill: #888888; -fx-font-size: 13px;" text="Completa la información del libro. El archivo PDF será almacenado de forma segura." wrapText="true" />

                            <!-- Título -->
                            <VBox spacing="6">
                                <Label style="-fx-text-fill: #cccccc; -fx-font-size: 13px;" text="Título del libro *" />
                                <TextField fx:id="titleField" promptText="Ej: Clean Code" style="-fx-background-color: #2c2c2c; -fx-text-fill: #ffffff;                                                   -fx-prompt-text-fill: #555555; -fx-background-radius: 8;                                                   -fx-border-color: #3a3a3a; -fx-border-radius: 8;                                                   -fx-padding: 10 14; -fx-font-size: 14px;" />
                            </VBox>

                            <!-- Autor -->
                            <VBox spacing="6">
                                <Label style="-fx-text-fill: #cccccc; -fx-font-size: 13px;" text="Autor *" />
                                <TextField fx:id="authorField" promptText="Ej: Robert C. Martin" style="-fx-background-color: #2c2c2c; -fx-text-fill: #ffffff;                                                   -fx-prompt-text-fill: #555555; -fx-background-radius: 8;                                                   -fx-border-color: #3a3a3a; -fx-border-radius: 8;                                                   -fx-padding: 10 14; -fx-font-size: 14px;" />
                            </VBox>

                            <!-- ISBN y Categoría en fila -->
                            <HBox spacing="16">
                                <VBox spacing="6" HBox.hgrow="ALWAYS">
                                    <Label style="-fx-text-fill: #cccccc; -fx-font-size: 13px;" text="ISBN" />
                                    <TextField fx:id="isbnField" promptText="978-..." style="-fx-background-color: #2c2c2c; -fx-text-fill: #ffffff;                                                       -fx-prompt-text-fill: #555555; -fx-background-radius: 8;                                                       -fx-border-color: #3a3a3a; -fx-border-radius: 8;                                                       -fx-padding: 10 14; -fx-font-size: 14px;" />
                                </VBox>
                                <VBox spacing="6" HBox.hgrow="ALWAYS">
                                    <Label style="-fx-text-fill: #cccccc; -fx-font-size: 13px;" text="Categoría *" />
                                    <ComboBox fx:id="categoryCombo" maxWidth="Infinity" promptText="Selecciona una categoría" style="-fx-background-color: #2c2c2c; -fx-text-fill: #ffffff;                                                      -fx-border-color: #3a3a3a; -fx-border-radius: 8;                                                      -fx-background-radius: 8; -fx-font-size: 13px;" />
                                </VBox>
                            </HBox>

                            <!-- Descripción -->
                            <VBox spacing="6">
                                <Label style="-fx-text-fill: #cccccc; -fx-font-size: 13px;" text="Descripción" />
                                <TextArea fx:id="descriptionArea" prefRowCount="4" promptText="Breve descripción del contenido del libro..." style="-fx-background-color: #2c2c2c; -fx-text-fill: #ffffff;                                                  -fx-prompt-text-fill: #555555; -fx-background-radius: 8;                                                  -fx-border-color: #3a3a3a; -fx-border-radius: 8;                                                  -fx-padding: 10 14; -fx-font-size: 14px;" wrapText="true" />
                            </VBox>

                            <!-- Selector de PDF -->
                            <VBox spacing="6">
                                <Label style="-fx-text-fill: #cccccc; -fx-font-size: 13px;" text="Archivo PDF *" />
                                <HBox alignment="CENTER_LEFT" spacing="10">
                                    <TextField fx:id="filePathField" editable="false" promptText="Ningún archivo seleccionado" style="-fx-background-color: #2c2c2c; -fx-text-fill: #888888;                                                       -fx-prompt-text-fill: #555555; -fx-background-radius: 8;                                                       -fx-border-color: #3a3a3a; -fx-border-radius: 8;                                                       -fx-padding: 10 14; -fx-font-size: 13px;" HBox.hgrow="ALWAYS" />
                                    <Button onAction="#selectPDF" style="-fx-background-color: #2c2c2c; -fx-text-fill: #03dac6;                                                    -fx-border-color: #03dac6; -fx-border-radius: 8;                                                    -fx-background-radius: 8; -fx-padding: 10 16;                                                    -fx-cursor: hand;" text="Seleccionar PDF" />
                                </HBox>
                            </VBox>

                            <!-- Mensajes -->
                            <Label fx:id="errorLabel" style="-fx-text-fill: #cf6679; -fx-font-size: 12px;" text="" wrapText="true" />
                            <Label fx:id="successLabel" style="-fx-text-fill: #4caf50; -fx-font-size: 12px;" text="" wrapText="true" />

                            <!-- Botón publicar -->
                            <Button fx:id="publishButton" maxWidth="Infinity" onAction="#handlePublish" style="-fx-background-color: #03dac6; -fx-text-fill: #000000;                                            -fx-font-weight: bold; -fx-font-size: 14px;                                            -fx-background-radius: 8; -fx-padding: 13 0;                                            -fx-cursor: hand;" text="Publicar libro" />
                        </VBox>
                    </VBox>
                </ScrollPane>
            </Tab>
        </TabPane>
    </center>

</BorderPane>
